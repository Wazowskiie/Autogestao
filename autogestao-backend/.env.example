DATABASE_URL="postgresql://autogestao:autogestao_dev@localhost:5433/autogestao_dev?schema=public"
JWT_ACCESS_SECRET="GENERATE_ME"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
TOKEN_ENCRYPTION_KEY="GENERATE_ME"
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# demo: respostas fixas. ollama: LLM local. openai: API externa.
CHAT_PROVIDER=demo
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_MS=120000
OPENAI_API_KEY=
# Preencha com o identificador do modelo habilitado na sua conta.
OPENAI_MODEL=
# Integrações anteriores opcionais para executar o chat.
ENABLE_BILLING=true
ENABLE_FISCAL=true
ASAAS_API_KEY=
DEMO_SEED=true
# Endereço público da API (links das fotos dos veículos)
PUBLIC_API_URL=http://localhost:3000
# Consulta de placa (API Placas)
PLACAS_API_TOKEN=
# Assistente virtual (Claude, da Anthropic). Crie a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
# Máximo de perguntas por pessoa por dia (controle de custo)
ASSISTANT_DAILY_LIMIT=150
# Assinatura eletrônica (D4Sign). Conta da Chronos; cada loja ganha uma pasta no cofre.
# Testes: https://sandbox.d4sign.com.br/api/v1   Produção: https://secure.d4sign.com.br/api/v1
D4SIGN_BASE_URL=https://sandbox.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=
# "Gerar Secret Key MAC" no menu Dev API da D4Sign (confere os avisos de assinatura)
D4SIGN_HMAC_SECRET=
